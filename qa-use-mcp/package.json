{
  "name": "qa-use-mcp",
  "version": "1.0.0",
  "description": "QA Use MCP Server - Quality assurance testing tools for Model Context Protocol",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "bun run build && node dist/src/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.{ts,js}",
    "release": "node scripts/release.js",
    "test": "bun run lint && bun run typecheck"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qa",
    "testing",
    "automation",
    "desplega"
  ],
  "author": "TestFox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/testfox/qa-use-mcp"
  },
  "homepage": "https://github.com/testfox/qa-use-mcp#readme",
  "bugs": {
    "url": "https://github.com/testfox/qa-use-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "playwright": "^1.40.0",
    "localtunnel": "^2.0.2",
    "axios": "^1.6.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
